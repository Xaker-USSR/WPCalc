<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1a1a1a"
    android:paddingTop="?attr/actionBarSize">

    <!-- Верхняя панель с меню, режимом, индикаторами и историей -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="12dp"
            android:src="@drawable/ic_menu"
            tools:ignore="SpeakableTextPresentCheck" />

        <TextView
            android:id="@+id/tvMode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Обычный"
            android:textColor="#aaaaaa"
            android:textSize="18sp"
            android:layout_marginStart="8dp" />

        <!-- Индикаторы (можно оставить, можно убрать) -->
        <TextView
            android:id="@+id/tvDegRad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DEG"
            android:textColor="#aaaaaa"
            android:textSize="16sp"
            android:padding="8dp" />

        <TextView
            android:id="@+id/tvFE"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="F-E"
            android:textColor="#aaaaaa"
            android:textSize="16sp"
            android:padding="8dp" />

        <ImageButton
            android:id="@+id/btnHistory"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="12dp"
            android:src="@drawable/ic_history" />
    </LinearLayout>

    <!-- Дисплей результата -->
    <TextView
        android:id="@+id/tvResult"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.5"
        android:gravity="end|bottom"
        android:padding="16dp"
        android:text="0"
        android:textColor="#ffffff"
        android:textSize="48sp"
        android:textStyle="bold" />

    <!-- Строка памяти (6 кнопок) – остаётся всегда видимой -->
    <LinearLayout
        android:id="@+id/memoryLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:weightSum="6">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnMC"
            style="@style/WP10TopButton"
            android:text="MC"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnMR"
            style="@style/WP10TopButton"
            android:text="MR"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnMPlus"
            style="@style/WP10TopButton"
            android:text="M+"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnMMinus"
            style="@style/WP10TopButton"
            android:text="M-"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnMS"
            style="@style/WP10TopButton"
            android:text="MS"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnMTriangle"
            style="@style/WP10TopButton"
            android:text="▼"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- Контейнер для кнопок режима (сюда будет загружаться либо обычный, либо инженерный) -->
    <FrameLayout
        android:id="@+id/buttonPanel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="8" />

</LinearLayout>