<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#2a2a2a"
    android:padding="4dp">

    <!-- Первый ряд: 2nd, sin, cos, tan -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnMenu2nd"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="2nd"
            android:textColor="#ffffff"
            android:background="#000000"
            android:textSize="14sp"
            android:minWidth="80dp"
            android:padding="4dp"
            android:gravity="center" />

        <Button
            android:id="@+id/btnMenuSin"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="sin"
            android:textColor="#ffffff"
            android:background="#000000"
            android:textSize="14sp"
            android:minWidth="80dp"
            android:padding="4dp"
            android:gravity="center" />

        <Button
            android:id="@+id/btnMenuCos"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="cos"
            android:textColor="#ffffff"
            android:background="#000000"
            android:textSize="14sp"
            android:minWidth="80dp"
            android:padding="4dp"
            android:gravity="center" />

        <Button
            android:id="@+id/btnMenuTan"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="tan"
            android:textColor="#ffffff"
            android:background="#000000"
            android:textSize="14sp"
            android:minWidth="80dp"
            android:padding="4dp"
            android:gravity="center" />
    </LinearLayout>

    <!-- Второй ряд: hyp, sec, csc, cot -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnMenuHyp"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="hyp"
            android:textColor="#ffffff"
            android:background="#3a3a3a"
            android:textSize="14sp"
            android:minWidth="80dp"
            android:padding="4dp"
            android:gravity="center" />

        <Button
            android:id="@+id/btnMenuSec"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="sec"
            android:textColor="#ffffff"
            android:background="#000000"
            android:textSize="14sp"
            android:minWidth="80dp"
            android:padding="4dp"
            android:gravity="center" />

        <Button
            android:id="@+id/btnMenuCsc"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="csc"
            android:textColor="#ffffff"
            android:background="#000000"
            android:textSize="14sp"
            android:minWidth="80dp"
            android:padding="4dp"
            android:gravity="center" />

        <Button
            android:id="@+id/btnMenuCot"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:text="cot"
            android:textColor="#ffffff"
            android:background="#000000"
            android:textSize="14sp"
            android:minWidth="80dp"
            android:padding="4dp"
            android:gravity="center" />
    </LinearLayout>
</LinearLayout>