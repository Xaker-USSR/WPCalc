<resources>
    <!-- Базовая тема приложения -->
    <style name="Theme.WP10Calculator" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">#000000</item>
    </style>

    <!-- Базовый стиль для всех кнопок -->
    <style name="WP10BaseButton" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:textColor">#ffffff</item>
        <item name="android:textSize">20sp</item>
        <item name="android:gravity">center</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:padding">0dp</item>
        <!-- Отключаем подкраску фона -->
        <item name="android:backgroundTint">@null</item>
    </style>

    <!-- Кнопки верхней части (память, функции) - чёрные -->
    <style name="WP10TopButton" parent="WP10BaseButton">
        <item name="android:background">#1A1A1A</item>
    </style>

    <!-- Цифровые кнопки и операторы - светло-серые -->
    <style name="WP10DigitButton" parent="WP10BaseButton">
        <item name="android:background">#3a3a3a</item>
    </style>
</resources>